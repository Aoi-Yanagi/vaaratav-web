generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  // Note: The 'url' property has been safely removed for Prisma 7 compatibility. 
  // Prisma will now read the connection URL directly from your prisma.config.ts file!
}

// --------------------------------------
// NEXTAUTH REQUIRED MODELS
// --------------------------------------

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------------
// YOUR APP'S CUSTOM MODELS
// --------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  meetings      Meeting[] 
}

model Meeting {
  id          String    @id @default(cuid())
  title       String
  meetingCode String    @unique
  status      String    @default("WAITING") // Can be "WAITING" or "COMPLETED"
  
  // Timestamps for your dashboard analytics
  startTime   DateTime? 
  endTime     DateTime? 
  createdAt   DateTime  @default(now())

  // Relation mapping the meeting to the host User
  hostId      String
  host        User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
}